{
  "schemaVersion": 1,
  "id": "copycats",
  "version": "${version}",
  "name": "Create: Copycats+",
  "description": "All the copycats you've ever wanted, combined into a single mod!\n\nUnofficial Fabric 26.1.2 port on Create Fly, for private server use with the authors' permission.",
  "authors": ["Lysine", "Bennyboy1695", "Redcat_XVIII"],
  "contact": {
    "sources": "https://github.com/copycats-plus/copycats",
    "issues": "https://github.com/copycats-plus/copycats/issues"
  },
  "license": "ARR",
  "icon": "copycats_icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.copycatsplus.copycats.fabric.CopycatsImpl"],
    "client": ["com.copycatsplus.copycats.fabric.CopycatsClientImpl"],
    "jei_mod_plugin": ["com.copycatsplus.copycats.compat.recipe_viewers.CopycatsJEI"]
  },
  "accessWidener": "copycats.accesswidener",
  "mixins": ["copycats-common.mixins.json", "copycats-fabric.mixins.json"],
  "depends": {
    "minecraft": "${minecraft_version}",
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "forgeconfigapiport": ">=${forgeconfigapiport_version}",
    "create": "${create_fly_version_range}",
    "java": ">=25"
  }
}
